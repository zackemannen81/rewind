# Unity-specific ignores
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can be huge
/[Mm]emoryCaptures/

# Asset meta files should only be ignored when the asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated project files
.vs/
.vscode/
.idea/
*.sln
*.csproj
*.unityproj

# Builds
*.apk
*.aab

# Crash reports
*.crash

# Unity packages
*.unitypackage

# Gradle cache
.gradle/

# Various temporary files
*.tmp
